{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFRICANIES per-symbol parity mappings",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "allowedStatuses", "mappings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "allowedStatuses": { "const": ["equivalent", "renamed", "type-erased", "angular-only", "missing"] },
    "mappings": {
      "type": "array",
      "minItems": 485,
      "maxItems": 485,
      "items": {
        "type": "object",
        "required": ["angularSymbol", "angularPackage", "kind", "status", "vanillaSymbol", "evidence", "rationale", "demonstration"],
        "additionalProperties": false,
        "properties": {
          "angularSymbol": { "type": "string", "minLength": 1 },
          "angularPackage": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["type", "value", "unknown"] },
          "status": { "enum": ["equivalent", "renamed", "type-erased", "angular-only", "missing"] },
          "vanillaSymbol": { "type": ["string", "null"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rationale": { "type": "string", "minLength": 1 },
          "demonstration": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "required": ["route", "selector"], "additionalProperties": false, "properties": { "route": { "type": "string", "pattern": "^/" }, "selector": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    }
  }
}

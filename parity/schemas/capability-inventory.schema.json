{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFRICANIES Angular-to-Vanilla capability inventory",
  "type": "object",
  "required": ["schemaVersion", "source", "generatedAt", "columns", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["repository", "revision", "declarationHeads"],
      "properties": { "declarationHeads": { "const": 485 } }
    },
    "columns": {
      "const": ["domain", "angularPackage", "angularDeclarations", "vanillaPackage", "vanillaExports", "status", "evidence"]
    },
    "rows": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["domain", "angularPackage", "angularDeclarations", "vanillaPackage", "vanillaExports", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "angularPackage": { "type": "string", "minLength": 1 },
          "angularDeclarations": { "type": "array", "items": { "type": "string" } },
          "vanillaPackage": { "type": "string", "minLength": 1 },
          "vanillaExports": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["matched", "partial", "gap"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
